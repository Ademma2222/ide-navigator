{
  "name": "ide-navigator",
  "displayName": "IDE Navigator",
  "description": "Static analysis navigation plugin: Go to Definition, References, Outline, Call Graph",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ide-navigator.showCallGraph",
        "title": "IDE Navigator: Show Call Graph"
      },
      {
        "command": "ide-navigator.showReferences",
        "title": "IDE Navigator: Show References"
      }
    ],
    "keybindings": [
      {
        "command": "ide-navigator.showReferences",
        "key": "shift+f12",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "IDE Navigator",
      "properties": {
        "ideNavigator.logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warning", "error"],
          "default": "info",
          "description": "Уровень логирования Python-сервера."
        },
        "ideNavigator.cacheSize": {
          "type": "integer",
          "default": 32,
          "minimum": 1,
          "maximum": 256,
          "description": "Максимальное количество AST-деревьев в кэше парсера."
        },
        "ideNavigator.enableCallGraph": {
          "type": "boolean",
          "default": true,
          "description": "Включить команду построения графа вызовов."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.115.0",
    "typescript": "^6.0.2",
    "vscode-languageclient": "^9.0.1"
  }
}
